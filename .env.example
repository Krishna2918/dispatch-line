# Demo is the default when Supabase URL is unset.
# Set NEXT_PUBLIC_DEMO_MODE=0 and fill live keys to use real providers.
NEXT_PUBLIC_DEMO_MODE=1

# Optional future staff login. Unset = every /login password attempt fails.
DISPATCH_ADMIN_ID=
DISPATCH_ADMIN_PASSWORD=

# --- Live Supabase (optional) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Live Twilio (optional — never set on the public demo) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public HTTPS URL Twilio should POST inbound SMS to:
# https://<your-domain>/api/twilio/inbound
TWILIO_WEBHOOK_URL=
